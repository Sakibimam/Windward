{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(*.key)",
      "Read(*.pem)",
      "Read(keystore/**)",
      "Read(secrets/**)",
      "Read(~/.foundry/keystores/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.bashrc)",
      "Edit(~/.gitconfig)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git add .env)",
      "Bash(git add -f:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(cast wallet private-key:*)",
      "Bash(cast wallet decrypt-keystore:*)"
    ],
    "ask": [
      "Bash(forge script:*)",
      "Bash(forge create:*)",
      "Bash(forge verify-contract:*)",
      "Bash(cast send:*)",
      "Bash(cast wallet:*)",
      "Bash(cast rpc:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git clean:*)",
      "Bash(git submodule update:*)",
      "Bash(forge update:*)",
      "Bash(forge install:*)",
      "Bash(rm:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(brew:*)",
      "Bash(foundryup:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "TodoWrite",
      "Task",
      "Edit(/src/**)",
      "Edit(/test/**)",
      "Edit(/script/**)",
      "Edit(/docs/**)",
      "Edit(/.claude/**)",
      "Edit(/*.md)",
      "Edit(/foundry.toml)",
      "Edit(/remappings.txt)",
      "Edit(/.gitignore)",
      "Edit(/.gitmodules)",
      "Edit(/.env.example)",
      "Bash(forge build:*)",
      "Bash(forge test:*)",
      "Bash(forge fmt:*)",
      "Bash(forge coverage:*)",
      "Bash(forge snapshot:*)",
      "Bash(forge clean:*)",
      "Bash(forge inspect:*)",
      "Bash(forge config:*)",
      "Bash(forge remappings:*)",
      "Bash(forge --version)",
      "Bash(cast call:*)",
      "Bash(cast code:*)",
      "Bash(cast storage:*)",
      "Bash(cast block:*)",
      "Bash(cast block-number:*)",
      "Bash(cast chain-id:*)",
      "Bash(cast tx:*)",
      "Bash(cast receipt:*)",
      "Bash(cast logs:*)",
      "Bash(cast sig:*)",
      "Bash(cast 4byte:*)",
      "Bash(cast abi-decode:*)",
      "Bash(cast to-dec:*)",
      "Bash(cast to-hex:*)",
      "Bash(cast keccak:*)",
      "Bash(cast compute-address:*)",
      "Bash(cast --version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git ls-tree:*)",
      "Bash(git check-ignore:*)",
      "Bash(git rev-parse:*)",
      "Bash(git submodule status:*)",
      "Bash(git branch:*)",
      "Bash(git init:*)",
      "Bash(git --version)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(chmod +x:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(npm run:*)",
      "Bash(npm ls:*)",
      "Bash(uname:*)",
      "Bash(sw_vers:*)",
      "Bash(env:*)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.uniswap.org)",
      "WebFetch(domain:developers.uniswap.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:*.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:eips.ethereum.org)",
      "WebFetch(domain:ethereum.org)",
      "WebFetch(domain:docs.soliditylang.org)",
      "WebFetch(domain:book.getfoundry.sh)",
      "WebFetch(domain:docs.openzeppelin.com)",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
