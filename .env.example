# Windward — environment template.
# Copy to `.env` and fill in. `.env` is gitignored and MUST NEVER be committed.
# This file contains PLACEHOLDERS ONLY. Never put a real key, URL with an embedded
# API key, private key, or mnemonic in this file.

# ---------------------------------------------------------------------------
# RPC endpoints (read-only use: fork tests, state queries)
# ---------------------------------------------------------------------------
# Unichain mainnet, chain id 130.
# The public endpoint https://mainnet.unichain.org works and served archive state
# during recon (see docs/RECON.md §2), but is rate limited. Use a provider URL
# for fork test suites.
UNICHAIN_RPC_URL=https://mainnet.unichain.org

# Unichain Sepolia testnet, chain id 1301.
UNICHAIN_SEPOLIA_RPC_URL=https://sepolia.unichain.org

# Ethereum mainnet. Needed only if a fork reproduction requires Ethereum-side state.
# An ARCHIVE endpoint is required for historical fork blocks.
MAINNET_RPC_URL=

# ---------------------------------------------------------------------------
# Deployment credentials. Leave EMPTY unless you are deploying.
# ---------------------------------------------------------------------------
# Do NOT paste a raw private key here or in .env. Use a Foundry keystore account:
#   cast wallet import windward-deployer --interactive
#   forge script ... --account windward-deployer
# The account NAME is not a secret; the key stays encrypted in ~/.foundry/keystores.
DEPLOYER_ACCOUNT=

# Block explorer key for source verification. Not a spending credential.
ETHERSCAN_API_KEY=
